# --- Rust ---------------------------------------------------------------
# Cargo output. `**/target` covers a per-crate target dir, which some tools create.
/target
**/target
# Local overrides; `.cargo/config.toml` is sometimes committed, but a developer's
# machine-specific one should not be.
.cargo/config.toml

# --- Tauri --------------------------------------------------------------
# Code generated by `tauri-build` during compilation, including the icon set it
# derives from `icons/`. Regenerated on every build.
/crates/litediff-app/gen/

# --- Node / frontend ----------------------------------------------------
node_modules/
# Vite output, embedded into the Rust binary by `tauri-build`.
/app/dist/
# Test bundles produced by `npm test`.
/app/.tmp-test/
.tmp-test/

# --- Packaged artifacts ------------------------------------------------
# Built by `scripts/package-macos.sh` and `scripts/package-windows.ps1`.
# These are release outputs, not source.
/dist-macos/
/dist-windows/
# Tauri's own bundle output, written by `tauri build` on Windows.
/crates/litediff-app/target/
# Images and installers, however they were produced.
*.dmg
*.msi

# --- Editor / OS --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Local scratch -------------------------------------------------------
# Ad-hoc test repositories and throwaway fixtures.
.tmp-test/
*.local
